# These names must match app/core/config.py's Settings class exactly.
ENVIRONMENT=development

# Full SQLAlchemy async connection string (not separate host/port/user/password fields)
# Neon: paste the connection string from the Neon dashboard but change the start from
# postgresql:// to postgresql+asyncpg://  (the ?sslmode=... part is handled automatically).
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb
# true only when the database requires TLS (most hosted databases); a local install does not
DATABASE_SSL=true

# JWT Configuration 
SECRET_KEY=your_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Password reset
# Base URL of the React app; used to build the link in the reset email.
FRONTEND_URL=http://localhost:4173
PASSWORD_RESET_EXPIRE_MINUTES=30
# Local development only: with no SMTP_HOST the reset link is logged by the API
# and, when this is true, also returned in the response so you can click it.
# Leave false anywhere real users sign in.
EXPOSE_RESET_LINK=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@valora.local
SMTP_USE_TLS=true
