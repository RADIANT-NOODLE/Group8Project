from sqlalchemy import func, select
from sqlalchemy.ext.asyncio import AsyncSession

from app.property.models.property import Property


class PropertyRepository:
    def __init__(self, db: AsyncSession) -> None:
        self._db = db

    async def get_all(self, *, offset: int, limit: int) -> list[Property]:
        result = await self._db.execute(
            select(Property).order_by(Property.unit_id).offset(offset).limit(limit)
        )
        return list(result.scalars().all())

    async def count(self) -> int:
        result = await self._db.execute(select(func.count()).select_from(Property))
        return int(result.scalar_one())

    async def get_by_id(self, unit_id: int) -> Property | None:
        result = await self._db.execute(select(Property).where(Property.unit_id == unit_id))
        return result.scalar_one_or_none()
