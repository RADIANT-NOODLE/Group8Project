# Copy this file to production.env and fill it in. production.env is never committed.

# Ohio. Your Neon database is in us-east-2, so keep them together: a far-away
# database makes every page slow.
AWS_REGION=us-east-2
STACK_NAME=valora

# From the Neon dashboard. Change the start from postgresql:// to postgresql+asyncpg://
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb

# A NEW long random value, not the one from your laptop. To make one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Warned when the month's bill nears the limit below. AWS does not stop or cap anything.
BUDGET_EMAIL=
MONTHLY_BUDGET_USD=3

ACCESS_TOKEN_EXPIRE_MINUTES=30

# Leave empty to use the CloudFront address. Set it if you add your own domain later.
FRONTEND_URL=

# Needed for "forgot password" emails. Without these, no reset email is sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@valora.local
